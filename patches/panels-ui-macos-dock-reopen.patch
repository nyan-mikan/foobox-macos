+// Keep the main window in AppKit's hide/unhide cycle so Dock activation
+// restores it. Programmatic close still tears it down on quit.
+@interface FooUIPanelsMainWindow : NSWindow
+- (void)closeForShutdown;
+@end
+
+@implementation FooUIPanelsMainWindow
+- (void)performClose:(id)sender {
+    [self close];
+}
+- (void)close {
+    pui::log::info("ui", "hiding main window on close");
+    [NSApp hide:nil];
+}
+- (void)closeForShutdown {
+    [super close];
+}
+@end
 
